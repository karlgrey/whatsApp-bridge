<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.micha.whatsapp-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd $HOME/Development/whatsapp-bridge &amp;&amp; npx tsx src/bridge.ts</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/mca/Development/whatsapp-bridge/data/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mca/Development/whatsapp-bridge/data/bridge.log</string>
</dict>
</plist>
